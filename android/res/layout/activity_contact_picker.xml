<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:tint="@color/text"/>
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Pick contacts"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- Search -->
    <EditText
        android:id="@+id/contactSearchInput"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="Search by name or number"
        android:textColor="@color/text"
        android:textColorHint="@color/muted"
        android:background="@drawable/card_bg"
        android:textSize="14sp"
        android:padding="12dp"
        android:layout_margin="16dp"
        android:inputType="text"/>

    <!-- Selection count -->
    <TextView
        android:id="@+id/selectionCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No exceptions selected"
        android:textSize="12sp"
        android:textColor="@color/subtext"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"/>

    <!-- Contacts list -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/emptyContactsView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No matching contacts"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/contactsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>
    </ScrollView>

    <!-- Done -->
    <Button
        android:id="@+id/btnDone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="DONE"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@drawable/btn_accent"
        android:layout_margin="16dp"/>

</LinearLayout>
