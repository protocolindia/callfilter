<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">
        <TextView
            android:id="@+id/btnBackSmsProt"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="←"
            android:textSize="24sp"
            android:textColor="@color/text"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"/>
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="🛡️ SMS Protection"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Master enable -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="14dp">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Enable SMS Protection"
                        android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Scan incoming messages for phishing and spam"
                        android:textSize="12sp" android:textColor="@color/subtext"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/smsProtectSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Mode chooser -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROTECTION MODE"
                android:textSize="11sp"
                android:textColor="@color/muted"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:id="@+id/modePassive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">
                <TextView android:id="@+id/modePassiveRadio"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="○" android:textSize="20sp" android:textColor="@color/accent"
                    android:layout_marginEnd="12dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Passive scanner (recommended)"
                        android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Warns you about suspicious messages. They stay in your normal SMS app."
                        android:textSize="12sp" android:textColor="@color/subtext"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/modeDefaultApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="14dp"
                android:clickable="true"
                android:focusable="true">
                <TextView android:id="@+id/modeDefaultRadio"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="○" android:textSize="20sp" android:textColor="@color/accent"
                    android:layout_marginEnd="12dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Default SMS app"
                        android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Set CyberGuard as your SMS app to automatically move spam aside. Requires you to switch your default messaging app."
                        android:textSize="12sp" android:textColor="@color/subtext"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Flagged messages link -->
            <LinearLayout
                android:id="@+id/rowFlaggedMessages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📋" android:textSize="20sp" android:layout_marginEnd="12dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Flagged Messages"
                        android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text"/>
                    <TextView android:id="@+id/flaggedCountLabel"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="View detected threats"
                        android:textSize="12sp" android:textColor="@color/subtext"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="22sp" android:textColor="@color/subtext"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnTestDetection"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Run a test detection"
                android:textColor="@color/text"
                android:textStyle="bold"
                android:background="@drawable/btn_accent"
                android:layout_marginTop="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Simulates a phishing SMS to confirm alerts are working on this device."
                android:textSize="12sp"
                android:textColor="@color/muted"
                android:gravity="center"
                android:layout_marginTop="8dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
