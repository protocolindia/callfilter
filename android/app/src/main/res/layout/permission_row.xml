<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/input_bg">

    <LinearLayout
        android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView android:id="@+id/permRowTitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="15sp" android:textStyle="bold"
            android:textColor="@color/text"/>
        <TextView android:id="@+id/permRowDesc"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/subtext"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <TextView android:id="@+id/permRowStatus"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="22sp" android:textStyle="bold"
        android:layout_marginStart="12dp"
        android:layout_gravity="center_vertical"/>
</LinearLayout>
