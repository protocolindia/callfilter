<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="@color/text"
            android:contentDescription="Back"/>
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="🌐 Global Blocklist"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text"
            android:layout_marginStart="8dp"/>
        <Button
            android:id="@+id/btnGlobalSync"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="🔄 Sync Now"
            android:textSize="12sp"
            android:textColor="@color/text"
            android:background="@drawable/btn_type_inactive"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:minWidth="0dp"/>
    </LinearLayout>

    <!-- Stats row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="12dp"
            android:layout_marginEnd="8dp">
            <TextView
                android:id="@+id/globalTotalEntries"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total numbers"
                android:textSize="11sp"
                android:textColor="@color/subtext"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="12dp">
            <TextView
                android:id="@+id/globalActiveCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/reject"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Currently blocking"
                android:textSize="11sp"
                android:textColor="@color/subtext"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Last sync time -->
    <TextView
        android:id="@+id/globalLastSync"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Never synced"
        android:textSize="12sp"
        android:textColor="@color/muted"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"/>

    <!-- Info note -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable a reason category to block all matching numbers globally. Numbers blocked this way appear in your call log with a 🌐 symbol."
        android:textSize="12sp"
        android:textColor="@color/subtext"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:lineSpacingMultiplier="1.4"/>

    <!-- Reason cards list -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/globalReasonsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/globalEmptyView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No entries in the global blocklist yet.\nTap 'Sync Now' to download the latest list from the server."
                android:textSize="14sp"
                android:textColor="@color/subtext"
                android:gravity="center"
                android:paddingTop="48dp"
                android:lineSpacingMultiplier="1.5"
                android:visibility="visible"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
