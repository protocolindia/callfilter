<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/card_bg"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- Left column: pattern (big) + badges below -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rulePattern"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+91..."
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text"/>

        <TextView
            android:id="@+id/ruleContactName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="@color/accent"
            android:layout_marginTop="1dp"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/ruleTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PREFIX"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/white"
                android:background="@drawable/badge_type"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/ruleActionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✗ REJECT"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/white"
                android:background="@drawable/badge_reject"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Delete button: red X on dark surface -->
    <TextView
        android:id="@+id/btnDelete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="×"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/reject"
        android:background="@drawable/btn_delete"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"/>
</LinearLayout>
