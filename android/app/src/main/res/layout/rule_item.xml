<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/card_bg" android:padding="14dp"
    android:layout_marginBottom="8dp">
    <TextView android:id="@+id/ruleTypeBadge"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="PREFIX" android:textSize="10sp" android:textStyle="bold"
        android:textColor="@color/accent" android:background="@drawable/badge_accent"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:paddingTop="3dp" android:paddingBottom="3dp"
        android:layout_marginEnd="10dp"/>
    <TextView android:id="@+id/rulePattern"
        android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:text="+91..."
        android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text"/>
    <TextView android:id="@+id/ruleActionBadge"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="✗ Reject" android:textSize="12sp"
        android:textColor="@color/reject" android:layout_marginEnd="8dp"/>
    <Button android:id="@+id/btnDelete"
        android:layout_width="36dp" android:layout_height="36dp"
        android:text="×" android:textSize="20sp" android:textStyle="bold"
        android:textColor="#EF4444" android:background="@drawable/btn_delete"
        android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp"/>
</LinearLayout>
