<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp"
    android:background="@color/bg">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Change PIN" android:textSize="22sp" android:textStyle="bold"
        android:textColor="@color/text" android:layout_marginTop="24dp"
        android:layout_marginBottom="20dp"/>
    <EditText android:id="@+id/oldPinInput"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:hint="Current PIN" android:textColor="@color/text"
        android:textColorHint="@color/muted" android:background="@drawable/input_bg"
        android:paddingStart="12dp" android:paddingEnd="12dp"
        android:inputType="numberPassword" android:maxLength="4"
        android:textSize="18sp" android:gravity="center"
        android:layout_marginBottom="12dp"/>
    <EditText android:id="@+id/newPinInput"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:hint="New PIN" android:textColor="@color/text"
        android:textColorHint="@color/muted" android:background="@drawable/input_bg"
        android:paddingStart="12dp" android:paddingEnd="12dp"
        android:inputType="numberPassword" android:maxLength="4"
        android:textSize="18sp" android:gravity="center"
        android:layout_marginBottom="12dp"/>
    <EditText android:id="@+id/newPinInput2"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:hint="Confirm new PIN" android:textColor="@color/text"
        android:textColorHint="@color/muted" android:background="@drawable/input_bg"
        android:paddingStart="12dp" android:paddingEnd="12dp"
        android:inputType="numberPassword" android:maxLength="4"
        android:textSize="18sp" android:gravity="center"
        android:layout_marginBottom="20dp"/>
    <Button android:id="@+id/btnSavePinChange"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:text="Save" android:textStyle="bold" android:textSize="14sp"
        android:textColor="@color/white" android:background="@drawable/btn_accent"/>
</LinearLayout>
