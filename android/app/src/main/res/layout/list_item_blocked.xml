<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/card_bg"
    android:padding="14dp" android:layout_marginBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/globalBadge"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="&#x1F310;" android:textSize="16sp"
            android:layout_marginEnd="6dp" android:visibility="gone"/>
        <TextView android:id="@+id/blockedNumber"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="+91..."
            android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text"/>
        <TextView android:id="@+id/blockedTime"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="just now" android:textSize="12sp" android:textColor="@color/muted"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="4dp"
        android:gravity="center_vertical">
        <TextView android:id="@+id/blockedRule"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="PREFIX"
            android:textSize="12sp" android:textColor="@color/subtext"/>
        <TextView android:id="@+id/blockedReasonPill"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Spam" android:textSize="11sp" android:textStyle="bold"
            android:textColor="@color/reject" android:background="@drawable/badge_reject"
            android:paddingStart="8dp" android:paddingEnd="8dp"
            android:paddingTop="2dp" android:paddingBottom="2dp" android:visibility="gone"/>
    </LinearLayout>
    <TextView android:id="@+id/btnReportFraud"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🚩 Report fraud"
        android:textSize="12sp" android:textStyle="bold"
        android:textColor="@color/accent"
        android:paddingTop="8dp" android:paddingBottom="2dp"
        android:clickable="true" android:focusable="true"/>
</LinearLayout>
