<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0000000">

    <!-- Brand bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@color/card">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#x1F6E1;"
            android:textSize="22sp"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="CyberGuard AI"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/accent"/>
        <TextView
            android:id="@+id/popupDismiss"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="&#215;"
            android:textSize="22sp"
            android:textColor="@color/subtext"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/border"/>

    <!-- Number section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unknown caller"
            android:textSize="12sp"
            android:textColor="@color/subtext"
            android:layout_marginBottom="4dp"/>
        <!-- Scrollable number in case it's long -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <TextView
                android:id="@+id/popupNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/text"
                android:singleLine="true"/>
        </HorizontalScrollView>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap a reason below to block this number instantly"
            android:textSize="12sp"
            android:textColor="@color/subtext"
            android:layout_marginTop="6dp"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/border"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SELECT REASON"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/subtext"
        android:background="@color/bg"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"/>

    <!-- Reason buttons — populated programmatically, tap = instant block -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg">
        <LinearLayout
            android:id="@+id/reasonChipsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="12dp"/>
    </ScrollView>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/border"/>

    <!-- Skip only -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/card"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">
        <Button
            android:id="@+id/popupSkip"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="SKIP — Don&#39;t block"
            android:textSize="14sp"
            android:textColor="@color/subtext"
            android:background="@drawable/btn_type_inactive"
            android:minWidth="0dp"/>
        <!-- Hidden block button for programmatic use -->
        <Button
            android:id="@+id/popupBlock"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
