<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:padding="18dp"
    android:elevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📞"
            android:textSize="24sp"
            android:layout_marginEnd="10dp"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Block this number?"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text"/>
            <TextView
                android:id="@+id/popupNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+91..."
                android:textSize="13sp"
                android:textColor="@color/subtext"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
        <TextView
            android:id="@+id/popupDismiss"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="×"
            android:textSize="22sp"
            android:textColor="@color/subtext"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">
        <TextView
            android:id="@+id/popupBlock"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:text="✗ BLOCK"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/btn_reject_active"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:id="@+id/popupSkip"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:text="SKIP"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/subtext"
            android:background="@drawable/btn_type_inactive"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
</LinearLayout>
