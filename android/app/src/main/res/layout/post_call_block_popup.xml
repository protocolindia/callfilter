<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E8000000">

    <!-- Spacer top -->
    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

    <!-- Main card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="12"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:layout_margin="16dp"
        android:elevation="12dp">

        <!-- Brand header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/card"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#x1F6E1;"
                android:textSize="24sp"
                android:layout_marginEnd="10dp"/>
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="AI CallFilter"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/accent"/>
            <TextView
                android:id="@+id/popupDismiss"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="×"
                android:textSize="24sp"
                android:textColor="@color/subtext"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/border"/>

        <!-- Number section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unknown caller"
                android:textSize="12sp"
                android:textColor="@color/subtext"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:id="@+id/popupNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Would you like to block this number?"
                android:textSize="13sp"
                android:textColor="@color/subtext"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/border"/>

        <!-- Reason selector label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SELECT REASON TO BLOCK"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/subtext"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="8dp"/>

        <!-- Inline reason chips — populated programmatically -->
        <LinearLayout
            android:id="@+id/reasonChipsContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"/>

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:layout_marginTop="4dp">
            <Button
                android:id="@+id/popupBlock"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="52dp"
                android:text="Block"
                android:textSize="15sp"
                android:textColor="#fff"
                android:background="@drawable/btn_reject_active"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"/>
            <Button
                android:id="@+id/popupSkip"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="52dp"
                android:text="Skip"
                android:textSize="15sp"
                android:textColor="@color/subtext"
                android:background="@drawable/btn_type_inactive"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Spacer bottom -->
    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
