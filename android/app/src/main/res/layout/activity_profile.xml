<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:tint="@color/text"/>
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Identity card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_bg"
                android:padding="20dp">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:text="👤"
                    android:textSize="28sp"
                    android:gravity="center"
                    android:background="@drawable/badge_accent"
                    android:layout_marginEnd="14dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SIGNED IN"
                        android:textSize="11sp"
                        android:textColor="@color/muted"
                        android:letterSpacing="0.1"/>
                    <TextView
                        android:id="@+id/profileMobileLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+91..."
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Subscription card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="20dp"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✨"
                        android:textSize="20sp"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="SUBSCRIPTION"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text"
                        android:letterSpacing="0.1"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/profileSubStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Checking…"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/accept"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:id="@+id/profilePlanPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="@color/subtext"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/btnManageSubscription"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="Manage / Cancel subscription"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent"
                    android:background="@drawable/btn_type_inactive"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:layout_marginTop="14dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/btnViewPlans"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="🛒 Buy a plan"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@drawable/btn_accent"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:layout_marginTop="14dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Settings card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SETTINGS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/muted"
                    android:letterSpacing="0.1"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="20dp"/>

                <!-- Cloud contact sync -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📇"
                        android:textSize="22sp"
                        android:layout_marginEnd="14dp"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cloud contact sync"
                            android:textSize="15sp"
                            android:textColor="@color/text"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Upload contacts so they're available across devices"
                            android:textSize="11sp"
                            android:textColor="@color/subtext"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/contactsSyncSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/text"
                        android:trackTint="@color/accent"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"/>

                <!-- Change PIN -->
                <LinearLayout
                    android:id="@+id/rowChangePin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔐"
                        android:textSize="22sp"
                        android:layout_marginEnd="14dp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Change PIN"
                        android:textSize="15sp"
                        android:textColor="@color/text"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="22sp"
                        android:textColor="@color/subtext"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Auto-lock toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_bg"
                android:padding="20dp"
                android:layout_marginTop="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱️"
                    android:textSize="22sp"
                    android:layout_marginEnd="14dp"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto-lock"
                        android:textSize="15sp"
                        android:textColor="@color/text"/>
                    <TextView
                        android:id="@+id/autoLockSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Off"
                        android:textSize="11sp"
                        android:textColor="@color/subtext"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/autoLockSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="@color/text"
                    android:trackTint="@color/accent"/>
            </LinearLayout>

            <!-- Lock app NOW -->
            <LinearLayout
                android:id="@+id/rowLock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_bg"
                android:padding="20dp"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒"
                    android:textSize="22sp"
                    android:layout_marginEnd="14dp"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lock app"
                        android:textSize="15sp"
                        android:textColor="@color/text"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Require PIN on next open"
                        android:textSize="11sp"
                        android:textColor="@color/subtext"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="22sp"
                    android:textColor="@color/subtext"/>
            </LinearLayout>

            <!-- Logout -->
            <LinearLayout
                android:id="@+id/rowLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_bg"
                android:padding="20dp"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚪"
                    android:textSize="22sp"
                    android:layout_marginEnd="14dp"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Sign out"
                    android:textSize="15sp"
                    android:textColor="@color/reject"/>
            </LinearLayout>

            <!-- Auto-SMS Reply Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Auto-reply SMS when call is blocked"
                            android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Sends SMS automatically to blocked callers"
                            android:textSize="12sp" android:textColor="@color/subtext" android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAutoSms"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <EditText
                    android:id="@+id/etAutoSmsMessage"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="SMS message to send to blocked callers..."
                    android:textSize="13sp" android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:background="@drawable/btn_type_inactive"
                    android:padding="10dp" android:minLines="2" android:maxLines="4"
                    android:inputType="textMultiLine" android:gravity="top"/>
                <Button
                    android:id="@+id/btnSaveSmsMessage"
                    android:layout_width="wrap_content" android:layout_height="36dp"
                    android:text="Save message" android:textSize="12sp" android:textColor="#fff"
                    android:background="@drawable/btn_accent"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:layout_marginTop="8dp" android:minWidth="0dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvAppVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI CallFilter · v1.25.210"
                android:textSize="11sp"
                android:textColor="@color/muted"
                android:gravity="center"
                android:layout_marginTop="24dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
