<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:fitsSystemWindows="true">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">
        <ImageView
            android:id="@+id/btnProfileTop"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_person"
            android:padding="7dp"
            android:background="@drawable/badge_accent"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true"
            android:scaleType="fitCenter"
            android:contentDescription="Profile"/>
        <TextView
            android:id="@+id/topBarUserInfo"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Signed in"
            android:textSize="12sp"
            android:textColor="@color/subtext"
            android:singleLine="true"
            android:ellipsize="end"/>
        <TextView
            android:id="@+id/btnBlockAll"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="🛑"
            android:textSize="18sp"
            android:gravity="center"
            android:background="@drawable/badge_block"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Block all calls now"/>
        <TextView
            android:id="@+id/btnBlockAllCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/reject"
            android:paddingStart="2dp"
            android:paddingEnd="6dp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Disabled account banner -->
    <LinearLayout
        android:id="@+id/disabledBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/banner_block_all"
        android:padding="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️"
            android:textSize="22sp"
            android:layout_marginEnd="12dp"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your account is disabled"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contact admin to reactivate"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Block All Now banner — hidden until activated -->
    <LinearLayout
        android:id="@+id/blockAllBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/banner_block_all"
        android:padding="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛑"
            android:textSize="24sp"
            android:layout_marginEnd="12dp"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Block All Now is active"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"/>
            <TextView
                android:id="@+id/blockAllStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="@color/white"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
        <Button
            android:id="@+id/btnStopBlockAll"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="STOP"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/reject"
            android:background="@drawable/btn_stop_block_all"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:minWidth="0dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Protection Score ring -->
            <FrameLayout
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp">
                <pro.onephone.callfilter.ScoreRingView
                    android:id="@+id/scoreRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/scoreNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="48sp"
                        android:textStyle="bold"
                        android:textColor="@color/text"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/ 100"
                        android:textSize="13sp"
                        android:textColor="@color/subtext"
                        android:layout_marginTop="-4dp"/>
                    <TextView
                        android:id="@+id/scoreTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROTECTED"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/accept"
                        android:letterSpacing="0.08"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/scoreStatusLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your device is protected"
                android:textSize="13sp"
                android:textColor="@color/subtext"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <!-- Stat row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/card_bg"
                    android:padding="12dp"
                    android:layout_marginEnd="6dp">
                    <TextView
                        android:id="@+id/statAccept"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/accept"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACCEPT"
                        android:textSize="10sp"
                        android:textColor="@color/muted"
                        android:letterSpacing="0.1"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/card_bg"
                    android:padding="12dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp">
                    <TextView
                        android:id="@+id/statReject"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/reject"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REJECT"
                        android:textSize="10sp"
                        android:textColor="@color/muted"
                        android:letterSpacing="0.1"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/card_bg"
                    android:padding="12dp"
                    android:layout_marginStart="6dp">
                    <TextView
                        android:id="@+id/statTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOTAL"
                        android:textSize="10sp"
                        android:textColor="@color/muted"
                        android:letterSpacing="0.1"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Blocked Calls card -->
            <LinearLayout
                android:id="@+id/blockedCallsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚫"
                    android:textSize="28sp"
                    android:layout_marginEnd="14dp"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calls Blocked"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to view history"
                        android:textSize="12sp"
                        android:textColor="@color/subtext"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/blockedCallsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/reject"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="22sp"
                    android:textColor="@color/subtext"/>
            </LinearLayout>

            <!-- Contacts Only Mode -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginTop="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📇"
                    android:textSize="28sp"
                    android:layout_marginEnd="14dp"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Contacts Only Mode"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Block every caller not in your contacts"
                        android:textSize="12sp"
                        android:textColor="@color/subtext"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/contactsOnlySwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="@color/text"
                    android:trackTint="@color/accent"/>
            </LinearLayout>

            <!-- Schedules tile -->
            <include layout="@layout/home_schedules_card"/>

            <!-- Global Blocklist tile -->
            <LinearLayout
                android:id="@+id/cardGlobalBlocklist"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/card_bg" android:padding="16dp"
                android:layout_marginTop="12dp" android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="&#x1F310;" android:textSize="18sp" android:layout_marginEnd="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Global Blocklist" android:textSize="14sp"
                            android:textStyle="bold" android:textColor="@color/text"/>
                    </LinearLayout>
                    <TextView android:id="@+id/globalBlocklistSummary"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Tap to configure" android:textSize="12sp"
                        android:textColor="@color/subtext" android:layout_marginTop="2dp"/>
                </LinearLayout>
                <TextView android:id="@+id/globalBlocklistBadge"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="OFF" android:textSize="11sp" android:textStyle="bold"
                    android:textColor="@color/subtext" android:background="@drawable/badge_type"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="3dp" android:paddingBottom="3dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/nav_item_tint"
        app:itemTextColor="@color/nav_item_tint"
        app:labelVisibilityMode="labeled"/>
</LinearLayout>
